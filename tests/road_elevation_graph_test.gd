extends SceneTree
## The input is generated by the production custom-map compiler.
const Network = preload("res://scripts/world/traffic_network.gd")
const Planner = preload("res://scripts/world/road_route_planner.gd")
const Authoring = preload("res://scripts/dev/gameplay_authoring_analysis.gd")
var failures: Array[String] = []


func check(condition: bool, message: String) -> void:
	if not condition:
		failures.append(message)
		push_error(message)


func _initialize() -> void:
	var arguments := OS.get_cmdline_user_args()
	if arguments.size() != 1:
		push_error("Pass the baked elevation fixture after --")
		quit(1)
		return
	var data: Variant = JSON.parse_string(FileAccess.get_file_as_string(arguments[0]))
	if not data is Dictionary:
		push_error("Elevation fixture could not be read")
		quit(1)
		return
	var graph := Network.new()
	graph.build(data,true)
	var planner := Planner.new()
	planner.setup(graph,data)
	var forbidden: Array[Array] = [[0,1],[0,2],[1,2],[1,8],[2,4],[2,8],[3,9]]
	var links := {}
	for edge in graph.edges:
		for id in edge.next:
			var to: Dictionary = graph.edges[id]
			var a := int(edge.road)
			var b := int(to.road)
			if a == b:continue
			var pair := [mini(a,b),maxi(a,b)]
			check(not forbidden.has(pair),"Unexpected graph link %s" % str(pair))
			links[pair] = true
	check(links.has([1,3]),"Elevated crossroad has turns")
	check(links.has([1,4]),"Overpass connects to its ramp")
	check(links.has([4,5]),"Ramp meets ground approach")
	check(links.has([2,7]),"Tunnel connects to its portal ramp")
	for edge in graph.edges:
		if edge.connector or int(edge.road) not in [1,2]:continue
		var point: Dictionary = graph.point_on_edge(int(edge.id),float(edge.length_px)*.5)
		var layer := 1 if int(edge.road) == 1 else -1
		check(int(point.road_layer) == layer and is_equal_approx(float(point.height_m),layer*6.0),
			"Lane sample retains its signed elevation")
	var ambient := Network.new()
	ambient.build(data)
	var raised := ambient.recovery_target(Vector2(502,400)*20,Vector2.DOWN,-1,20.0*9.0,6.0)
	var tunnel := ambient.recovery_target(Vector2(502,400)*20,Vector2.DOWN,-1,20.0*9.0,-6.0)
	check(not raised.is_empty() and int(ambient.edges[raised.edge].road)==1,
		"Ambient traffic reprojects onto the elevated lane at an overlapping crossing")
	check(not tunnel.is_empty() and int(ambient.edges[tunnel.edge].road)==2,
		"Ambient traffic reprojects onto the tunnel lane independently")
	var route := planner.plan(Vector2(500,500),Vector2(350,700),Vector2.DOWN,
		"Overpass","South Approach",1,0)
	check(not route.is_empty(),"GPS uses an explicit ramp from deck to ground")
	var gates:=Authoring.graded_checkpoints(route,graph,1,0)
	check(gates.size()>=2 and int(gates[0].layer)==1 and int(gates[-1].layer)==0,"Automatic gates retain distinct physical start and finish layers")
	check(planner.plan(Vector2(500,500),Vector2(600,600),Vector2.DOWN,
		"Tunnel","Ground at Tunnel End",-1,0).is_empty(),"GPS rejects an XY-only connection")
	if failures.is_empty():
		print("ROAD ELEVATION GRAPH: PASS")
	quit(0 if failures.is_empty() else 1)
